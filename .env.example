# API key de Google Gemini para generación de partidas con IA.
# Si no se define, se puede configurar desde la app (Configuración > IA).
# CUBIAPP_GEMINI_KEY=tu_api_key_aqui

# API key de DeepSeek (proveedor IA alternativo, configurable desde la app).
# CUBIAPP_DEEPSEEK_KEY=tu_api_key_aqui

# Ruta absoluta personalizada para la base de datos SQLite.
# Prioridad real: ruta guardada en Settings > CUBIAPP_DB_PATH > ruta estable
# por defecto (~/Documents/CubiApp/datos.db) > datos.db en la raíz del
# proyecto (solo si la ruta estable no existe y ese fichero legacy contiene
# memoria histórica ya analizada).
# CUBIAPP_DB_PATH=C:\ruta\a\mi\datos.db

# Carpeta de configuración local (claves guardadas, rutas por defecto, etc.).
# Por defecto: ~/.cubiapp
# CUBIAPP_CONFIG_DIR=C:\ruta\a\mi\config

# Carpeta donde se guardan los backups automáticos de la BDD (creados antes
# de aplicar una migración de esquema, o al restaurar desde otro fichero).
# Por defecto: ~/Documents/CubiApp/backups
# CUBIAPP_BACKUP_DIR=C:\ruta\a\mis\backups
